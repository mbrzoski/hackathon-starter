<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>pl.aniolstroz</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aniol-stroz-backend</name>
    <description>Anioł Stróż backend</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.4.1</archunit.version>
        <networknt.version>2.0.1</networknt.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <anthropic-java.version>2.68.0</anthropic-java.version>
        <wiremock.version>3.13.2</wiremock.version>
        <openapi-generator.version>7.25.0</openapi-generator.version>
        <openapi-request-validator.version>3.0.0</openapi-request-validator.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${networknt.version}</version>
        </dependency>

        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>openapi-request-validator-mockmvc</artifactId>
            <version>${openapi-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- The scenario validator reads components/schemas from the one contract file. -->
                <directory>${project.basedir}/../contracts</directory>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
                <targetPath>contract</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!-- CON-03: interfaces and request/response models for the paths in contracts/openapi.yaml. -->
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../contracts/openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <apiPackage>pl.aniolstroz.contracts.api</apiPackage>
                            <modelPackage>pl.aniolstroz.contracts.model</modelPackage>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <!-- Shared schemas stay as the hand-written records in pl.aniolstroz.contracts. -->
                            <importMappings>
                                <importMapping>Mode=pl.aniolstroz.contracts.Mode</importMapping>
                                <importMapping>Alert=pl.aniolstroz.contracts.Alert</importMapping>
                                <importMapping>Decision=pl.aniolstroz.contracts.Decision</importMapping>
                                <importMapping>StageId=pl.aniolstroz.contracts.StageId</importMapping>
                                <importMapping>ProblemDetail=org.springframework.http.ProblemDetail</importMapping>
                                <importMapping>StatusResponse=pl.aniolstroz.config.StatusResponse</importMapping>
                                <importMapping>EventEnvelope=pl.aniolstroz.contracts.EventEnvelope</importMapping>
                            </importMappings>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <openApiNullable>false</openApiNullable>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useTags>true</useTags>
                                <documentationProvider>none</documentationProvider>
                                <annotationLibrary>none</annotationLibrary>
                                <useBeanValidation>true</useBeanValidation>
                            </configOptions>
                            <globalProperties>
                                <models>ReplayRequest,ScenarioSummary,DecisionRequest,AlertWithDecisions</models>
                            </globalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
