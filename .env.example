# Copy to .env (never commit .env). Secrets are read from environment variables only.

# --- Secrets ---
ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Optional overrides (defaults live in AppProperties) ---
# Mode: LIVE | REPLAY | SCRIPTED | MOCK
APP_MODE=SCRIPTED
# APP_CLAUDE_MODEL=claude-sonnet-5-5
# APP_CLAUDE_TIMEOUT_MS=2500

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
