# Copy to .env (never commit .env). Secrets are read from environment variables only.

# --- Secrets ---
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults live in AppProperties) ---
# Mode: LIVE | REPLAY | SCRIPTED | MOCK
APP_MODE=SCRIPTED
# APP_CLAUDE_MODEL=claude-sonnet-5-5
# Request timeout and max output tokens of the Claude call (defaults 8000 and 1024; measured calls take 2.5-3.9 s)
# APP_CLAUDE_TIMEOUT_MS=8000
# APP_CLAUDE_MAX_TOKENS=1024
# Local speech-to-text (Vosk): directory of the unpacked model vosk-model-small-pl-0.22 (not in the repository).
# APP_STT_VOSK_MODEL_PATH=/path/to/vosk-model-small-pl-0.22
# APP_STT_PROVIDER=vosk

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
