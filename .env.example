# Copy to .env (never commit .env). Every value here is optional except ANTHROPIC_API_KEY for real Claude calls.

# --- Claude ---
# Leave empty and set LLM_PROVIDER=mock to run fully offline.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_MAX_TOKENS=1024

# --- Database ---
DB_NAME=hackathon
DB_USER=hackathon
DB_PASSWORD=hackathon
DB_PORT=5432

# --- Ports / CORS ---
BACKEND_PORT=8080
FRONTEND_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081
