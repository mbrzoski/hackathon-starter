<?xml version="1.0" encoding="utf-8"?>
<!-- AND-02: https/wss only. The demo backend uses Caddy's own CA (deploy/ca.crt), installed on the tablet as a user
     certificate, so user certificates are trusted besides the system ones. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
